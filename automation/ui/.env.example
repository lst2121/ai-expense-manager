# ==============================================================================
# Playwright Automation Environment Template (Commit this to Git)
# Copy this file to .env and fill in environment-specific secrets
# ==============================================================================

# Application URLs
BASE_URL=http://localhost:5173
API_BASE_URL=http://127.0.0.1:8000

# Browser Execution Settings
HEADLESS=false
DEFAULT_TIMEOUT=30000
EXPECT_TIMEOUT=5000

# Test User Credentials
TEST_USER_EMAIL=user@company.com
TEST_USER_PASSWORD=YourSecurePassword!
TEST_USER_NAME=Test Candidate

# Database Credentials
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=optum_healthcare_db

